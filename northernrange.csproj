<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nr</AssemblyName>
    <RootNamespace>NorthernRange</RootNamespace>
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>beta</VersionSuffix>
    <!-- Suppress trim warnings: TrimMode=partial never trims NuGet assemblies or
         this one (not marked IsTrimmable), so reflection over our own command
         and model types (IL2070) and the framework's (IL2026/IL2104) is safe. -->
    <NoWarn>$(NoWarn);IL2026;IL2070;IL2104</NoWarn>
  </PropertyGroup>

  <!-- Publish settings: single-file, self-contained, partial trim. Applied only
       by `dotnet publish` so a plain `dotnet build` stays framework-dependent;
       that keeps the binary runnable from the test project's output directory
       (tests/ExitCodeE2ETests.cs launches it). -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="northernrange.Tests" />
    <!-- The test project lives under this directory; keep its sources out of the
         main app's default **/*.cs compilation glob. -->
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cocona" Version="2.2.0" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.68.0.3399" />
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
    <PackageReference Include="MimeKit" Version="4.15.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
